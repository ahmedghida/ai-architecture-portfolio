        <mxCell id="e3" value="Search, save, view events" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=default;" edge="1" parent="1" source="mkt" target="interactions">
          <mxGeometry relative="1" as="geometry"/>
