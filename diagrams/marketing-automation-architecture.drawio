        <mxCell id="e12" value="Draft message" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=default;" edge="1" parent="1" source="agent" target="verifier">
          <mxGeometry relative="1" as="geometry"/>
