        <mxCell id="e5" value="Segmentation (batch)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="models" target="interactions">
