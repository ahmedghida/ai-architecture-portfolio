        <mxCell id="e6" value="ETL job (24h)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=default;" edge="1" parent="1" source="interactions" target="segments">
          <mxGeometry relative="1" as="geometry"/>
