<mxfile host="app.diagrams.net">
  <diagram id="mkt-arch-v2" name="Marketing Automation - Property Seeker">
    <mxGraphModel dx="1240" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Containers -->
        <mxCell id="pdpl" value="PDPL zone [P3]" style="rounded=1;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="155" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="aic" value="AI platform" style="rounded=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="30" width="300" height="320" as="geometry"/>
        </mxCell>

        <!-- Actor and channels -->
        <mxCell id="seeker" value="Property Seeker" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="40" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Channel&#xa;App / Website" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="50" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mkt" value="Marketplace Service" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="50" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="wa" value="Channel&#xa;WhatsApp" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Data -->
        <mxCell id="listings" value="Listings and Prices&#xa;(source of truth) [P1]" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=12;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="150" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="interactions" value="Seeker interactions,&#xa;profiles and consent" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=12;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="190" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- Pipeline -->
        <mxCell id="segments" value="Seeker Segments" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="345" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="match" value="Matching Engine&#xa;pgvector + fixed rules&#xa;(no LLM) [P4]" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="335" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="agent" value="Content Agent (LLM)&#xa;fills WhatsApp template" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="470" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="verifier" value="Claim Verifier + Consent Check&#xa;[P1, P3]" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="590" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="approval" value="Human Approval Queue&#xa;[P2]" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="170" height="60" as="geometry"/>
        </mxCell>

        <!-- AI platform contents -->
        <mxCell id="models" value="Intent, segmentation and&#xa;drop-off models (batch)" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="70" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="gateway" value="LLM Gateway [P3, P4]&#xa;redaction · budget caps · fallback" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="170" width="260" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="Managed LLM API&#xa;(+ second provider)" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="275" width="260" height="55" as="geometry"/>
        </mxCell>

        <!-- Governance -->
        <mxCell id="evals" value="Evals and Monitoring [P4]&#xa;quality · cost · conversion" style="rounded=0;whiteSpace=wrap;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="400" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ci" value="CI guardrail + design-review agent [P1-P4]&#xa;ADR + checklist required; blocks merge on P1 / P3" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="495" width="300" height="65" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="P1 Facts from the source of truth  |  P2 Human oversight grows with risk  |  P3 Privacy by design (PDPL)  |  P4 Measured quality, bounded cost" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="700" width="1160" height="35" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="seeker" target="app">
          <mxGeometry relative="1" as="geometry"/>
