        <mxCell id="e4" value="Listings / prices" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;fontSize=10;labelBackgroundColor=default;" edge="1" parent="1" source="mkt" target="listings">
